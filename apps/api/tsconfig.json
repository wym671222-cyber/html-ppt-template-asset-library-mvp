{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/app.ts",
    "src/owner.ts",
    "src/env.ts",
    "src/auth/cookie.ts",
    "src/auth/password.ts",
    "src/auth/sessions.ts",
    "src/auth/throttle.ts",
    "src/auth/users.ts",
    "src/db/index.ts",
    "src/db/migrate.ts",
    "src/db/paths.ts",
    "src/db/schema.ts"
  ]
}
